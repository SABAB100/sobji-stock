# Copy these into your Vercel project environment variables.
# Get both values from your Upstash / Vercel KV store (see README.md).
# NEVER put real values in this file or commit it with values filled in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The ONE shared password for the stock app. The owner chooses any value
# and adds it in the Vercel dashboard (Project → Settings → Environment
# Variables → APP_PASSWORD), then redeploys. Everyone opening the link
# types this same password. NEVER put the real password in this file.
APP_PASSWORD=
